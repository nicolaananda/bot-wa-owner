---
const apiBase = import.meta.env.PUBLIC_OWNER_API_BASE || '/api/owner/v1';
---
<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="Dashboard operasional owner bot-wa"><title>Nicola Owner — bot-wa</title></head>
<body data-api={apiBase}>
  <aside><a class="brand" href="#overview">N<span>Owner Console</span></a><nav aria-label="Navigasi utama">
    <button data-view="overview">Ringkasan</button><button data-view="products">Produk & stok</button><button data-view="users">Pengguna & saldo</button><button data-view="transactions">Transaksi</button><button data-view="finance">Keuangan</button><button data-view="deposits-payments">Deposit & pembayaran</button><button data-view="zoom">Zoom</button><button data-view="services-otp">OTP & layanan</button><button data-view="configuration">Konfigurasi bot</button><button data-view="health">Health</button><button data-view="capabilities">Cakupan fitur</button>
  </nav><small>Data sensitif disamarkan.</small></aside>
  <main>
    <header><div><p class="eyebrow">OPERASIONAL / OWNER</p><h1 id="title">Ringkasan</h1><p id="subtitle">Kondisi bisnis dan layanan terkini.</p></div><div class="actions"><span id="connection">Memeriksa sesi…</span><button id="refresh">Muat ulang</button><button id="logout">Keluar</button></div></header>
    <section id="login" class="panel hidden"><h2>Masuk sebagai owner</h2><p>Nomor harus ada dalam allowlist server dan secret tidak disimpan di browser.</p><form id="loginForm"><label>Nomor owner<input name="owner" inputmode="numeric" autocomplete="username" required></label><label>Secret dashboard<input name="secret" type="password" autocomplete="current-password" required></label><button type="submit">Masuk aman</button><p id="loginError" role="alert"></p></form></section>
    <section id="toolbar" class="toolbar hidden"><label class="search">Cari<input id="search" type="search" placeholder="Cari ID, nama, atau status"></label><label id="statusWrap">Status<select id="status"><option value="">Semua</option><option>success</option><option>pending</option><option>failed</option></select></label></section>
    <section id="content" aria-live="polite"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></section>
    <footer><button id="prev">← Sebelumnya</button><span id="page"></span><button id="next">Berikutnya →</button></footer>
  </main>
<script>
// @ts-nocheck
const api = document.body.dataset.api; const $ = id => document.getElementById(id); let view='overview', currentPage=1, pages=1, csrf='';
const labels={overview:['Ringkasan','Kondisi bisnis dan layanan terkini.'],products:['Produk & stok','Katalog, harga, dan jumlah stok tanpa membuka credential.'],users:['Pengguna & saldo','Saldo dan peran pengguna; mutasi dinonaktifkan demi integritas.'],transactions:['Transaksi','Cari dan saring transaksi aktual.'],finance:['Keuangan','Agregat transaksi dari data produksi.'],'deposits-payments':['Deposit & pembayaran','Status flow pembayaran tanpa memicu provider.'],zoom:['Zoom','Kapasitas pool tanpa membuka credential host.'],'services-otp':['OTP & layanan','Jumlah order berdasarkan status; OTP tidak ditampilkan.'],configuration:['Konfigurasi bot','Status integrasi dan promo tanpa nilai secret.'],health:['Health','Kesehatan dependency dan anomali terdeteksi.'],capabilities:['Cakupan fitur','Dukungan aman saat ini dan alasan pembatasan.']};
const money=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(n||0)); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function request(path,options={}){const r=await fetch(`${api}${path}`,{credentials:'include',headers:{'Content-Type':'application/json',...(csrf?{'X-CSRF-Token':csrf}: {})},...options});const body=await r.json().catch(()=>({}));if(!r.ok)throw Object.assign(new Error(body.error||'Permintaan gagal'),{status:r.status});return body.data}
function empty(msg='Belum ada data untuk ditampilkan.'){return `<div class="empty"><b>Tidak ada data</b><p>${esc(msg)}</p></div>`} function cards(items){return `<div class="cards">${items.map(([k,v,s=''])=>`<article><p>${esc(k)}</p><strong>${esc(v)}</strong><small>${esc(s)}</small></article>`).join('')}</div>`}
function table(head,rows){if(!rows.length)return empty();return `<div class="table"><table><thead><tr>${head.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(v=>`<td>${esc(v)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`}
function render(data){pages=data?.pagination?.pages||1;$('page').textContent=pages>1?`Halaman ${currentPage} dari ${pages}`:'';$('prev').disabled=currentPage<=1;$('next').disabled=currentPage>=pages;
 if(view==='overview')return cards([['Pengguna',data.users],['Produk',data.products],['Stok tersedia',data.stock],['Transaksi',data.transactions],['Omzet tercatat',money(data.revenue),`Diperbarui ${new Date(data.generatedAt).toLocaleString('id-ID')}`]]);
 if(view==='products')return table(['Produk','Nama','Harga','Stok','Status'],(data.items||[]).map(x=>[x.id,x.name,money(x.price),x.stock,x.status]));
 if(view==='users')return table(['Pengguna','Nama','Saldo','Peran','Aktif'],(data.items||[]).map(x=>[x.displayId,x.username||'—',money(x.saldo),x.role,x.active?'Ya':'Tidak']));
 if(view==='transactions')return table(['Referensi','Pengguna','Produk','Pembayaran','Nominal','Status'],(data.items||[]).map(x=>[x.refId,x.userId?`••••${x.userId.replace(/\D/g,'').slice(-4)}`:'—',x.product||'—',x.payment||'—',money(x.amount),x.status]));
 if(view==='finance')return cards([['Nilai bruto',money(data.gross)],['Jumlah transaksi',data.count],...Object.entries(data.byStatus||{}).map(([k,v])=>[`Status ${k}`,v])]);
 if(view==='deposits-payments')return table(['Order','Status','Nominal','Dibuat'],(data.items||[]).map(x=>[x.id,x.status,money(x.amount),x.createdAt?new Date(x.createdAt).toLocaleString('id-ID'):'—']));
 if(view==='zoom')return table(['Tier','Host','Aktif','Nonaktif','Kapasitas'],(data.tiers||[]).map(x=>[x.tier,x.hosts,x.enabled,x.disabled,x.capacity]));
 if(view==='services-otp')return cards([['Total order OTP',data.total],...Object.entries(data.byState||{}).map(([k,v])=>[k,v])]);
 if(view==='configuration')return cards([['Database',data.database],['Promo',data.promo.enabled?'Aktif':'Nonaktif',`${data.promo.groups} grup`],...Object.entries(data.integrations).map(([k,v])=>[k,v?'Terpasang':'Tidak terpasang'])]);
 if(view==='health')return `<pre>${esc(JSON.stringify(data,null,2))}</pre>`;
 if(view==='capabilities')return table(['Area','Baca','Mutasi','Keterangan'],data.map(x=>[x.area,x.read?'Ya':'Tidak',x.write?'Ya':'Belum',x.reason])); return empty(); }
async function load(){ $('content').innerHTML='<div class="skeleton"></div><div class="skeleton"></div>';const query=new URLSearchParams({page:String(currentPage),limit:'20'});if($('search').value)query.set('search',$('search').value);if(view==='transactions'&&$('status').value)query.set('status',$('status').value);try{const data=await request(`/${view}?${query}`);$('connection').textContent='Tersambung';$('login').classList.add('hidden');$('content').innerHTML=render(data);const searchable=['products','users','transactions'].includes(view);$('toolbar').classList.toggle('hidden',!searchable);$('statusWrap').classList.toggle('hidden',view!=='transactions')}catch(e){if(e.status===401){$('login').classList.remove('hidden');$('content').innerHTML=empty('Masuk untuk membuka data owner.');$('connection').textContent='Belum masuk'}else{$('content').innerHTML=`<div class="error"><b>Data gagal dimuat</b><p>${esc(e.message)}</p><button onclick="location.reload()">Coba lagi</button></div>`;$('connection').textContent='Terputus'}}}
async function select(next){view=next;currentPage=1;[$('title').textContent,$('subtitle').textContent]=labels[view];document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===view));await load()}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>select(b.dataset.view));$('refresh').onclick=load;$('prev').onclick=()=>{currentPage--;load()};$('next').onclick=()=>{currentPage++;load()};let timer;$('search').oninput=()=>{clearTimeout(timer);timer=setTimeout(()=>{currentPage=1;load()},250)};$('status').onchange=()=>{currentPage=1;load()};$('loginForm').onsubmit=async e=>{e.preventDefault();$('loginError').textContent='';const form=new FormData(e.currentTarget);try{const data=await request('/auth/login',{method:'POST',body:JSON.stringify(Object.fromEntries(form))});csrf=data.csrfToken;e.currentTarget.reset();load()}catch(err){$('loginError').textContent=err.message}};$('logout').onclick=async()=>{try{await request('/auth/logout',{method:'POST'})}finally{csrf='';load()}};select('overview');
</script>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui;color:#20211d;background:#f4f3ee}*{box-sizing:border-box}body{margin:0;display:grid;grid-template-columns:250px 1fr;min-height:100vh}aside{background:#191b17;color:#f8f7f1;padding:28px 18px;position:sticky;top:0;height:100vh}.brand{color:#fff;text-decoration:none;font-size:24px;font-weight:900;display:flex;gap:12px;align-items:center;margin:0 10px 30px}.brand:first-letter{color:#d6fb4b}.brand span{font-size:14px;font-weight:700}nav{display:grid;gap:4px}button,input,select{font:inherit}nav button{border:0;background:transparent;color:#aaa;padding:11px 12px;text-align:left;border-radius:8px;cursor:pointer}nav button:hover,nav button.active{background:#30332c;color:#fff}aside small{position:absolute;bottom:24px;color:#85877f}main{padding:38px 5vw;min-width:0}header{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:30px}.eyebrow{font-size:11px;letter-spacing:.18em;font-weight:800;color:#73766b}h1{font-size:38px;margin:4px 0}header p{margin:0;color:#6b6d65}.actions{display:flex;gap:10px;align-items:center}.actions button,footer button,form button,.error button{border:1px solid #d7d6cf;background:#fff;border-radius:8px;padding:9px 13px}.actions span{font-size:12px;color:#477016}.toolbar{display:flex;gap:14px;margin-bottom:16px}.toolbar label,form label{display:grid;gap:6px;font-size:12px;color:#61635c}.search{flex:1}input,select{border:1px solid #d7d6cf;background:#fff;border-radius:8px;padding:11px}.panel,.cards article,.table,.empty,.error,pre{background:#fff;border:1px solid #e1e0da;border-radius:12px}.panel{padding:30px;max-width:500px}.panel form{display:grid;gap:16px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px}.cards article{padding:20px;min-height:130px}.cards p{margin:0;color:#73766b;font-size:12px}.cards strong{display:block;font-size:25px;margin:18px 0 8px}.cards small{color:#777}.table{overflow:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:14px;border-bottom:1px solid #ecebe6;font-size:13px}th{font-size:11px;text-transform:uppercase;color:#777;background:#fafaf7}.empty,.error{padding:55px;text-align:center;color:#676961}.skeleton{height:130px;border-radius:12px;margin-bottom:14px;background:linear-gradient(90deg,#e8e7e1,#f6f5f1,#e8e7e1);background-size:200%;animation:p 1.2s infinite}@keyframes p{to{background-position:-200%}}pre{padding:22px;overflow:auto;white-space:pre-wrap}footer{display:flex;justify-content:flex-end;align-items:center;gap:14px;margin-top:18px;font-size:12px}.hidden{display:none!important}#loginError{color:#a42525}
@media(max-width:800px){body{display:block}aside{height:auto;position:static;padding:16px}.brand{margin:0 4px 14px}nav{display:flex;overflow:auto}nav button{white-space:nowrap}aside small{display:none}main{padding:24px 16px}header{display:block}h1{font-size:30px}.actions{margin-top:18px;flex-wrap:wrap}.toolbar{display:grid}.cards{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.cards{grid-template-columns:1fr}header .actions span{width:100%}}
</style></body></html>
