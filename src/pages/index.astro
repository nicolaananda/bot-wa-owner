---
const apiBase = '/api/owner/v1';
---
<!doctype html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Dashboard operasional owner bot-wa"><title>Nicola Owner — bot-wa</title></head>
<body data-api={apiBase} class="auth-pending">
  <header class="topbar"><button id="menu" class="icon-button" aria-label="Buka navigasi" aria-expanded="false"><span></span><span></span><span></span></button><a class="brand" href="#overview" aria-label="Nicola Owner"><i aria-hidden="true">N</i><strong>Nicola</strong><span>Owner</span></a><div class="top-actions"><span id="connection" role="status">Memeriksa sesi…</span><button id="refresh" class="icon-button" aria-label="Muat ulang data" title="Muat ulang">↻</button><button id="logout">Keluar</button></div></header>
  <div id="scrim" class="scrim"></div>
  <aside id="sidebar"><div class="nav-label">OPERASIONAL</div><nav aria-label="Navigasi utama">
    <button data-view="overview"><i>⌂</i><span>Ringkasan</span></button><button data-view="products"><i>◇</i><span>Produk & stok</span></button><button data-view="users"><i>♙</i><span>Pengguna & saldo</span></button><button data-view="transactions"><i>⇄</i><span>Transaksi</span></button><button data-view="finance"><i>◫</i><span>Keuangan</span></button><button data-view="deposits-payments"><i>▣</i><span>Deposit & pembayaran</span></button><button data-view="zoom"><i>◉</i><span>Zoom</span></button><button data-view="services-otp"><i>⌁</i><span>OTP & layanan</span></button><button data-view="configuration"><i>⚙</i><span>Konfigurasi bot</span></button><button data-view="health"><i>♡</i><span>Health</span></button><button data-view="capabilities"><i>✓</i><span>Cakupan fitur</span></button>
  </nav><p class="privacy">◈ Data sensitif disamarkan</p></aside>
  <main id="app">
    <header class="page-head"><div><p class="eyebrow">OWNER CONSOLE / <span id="crumb">RINGKASAN</span></p><h1 id="title">Ringkasan</h1><p id="subtitle">Kondisi bisnis dan layanan terkini.</p></div></header>
    <section id="toolbar" class="toolbar hidden" aria-label="Filter data"><label class="search"><span>Cari</span><input id="search" type="search" placeholder="Cari ID, nama, atau status"></label><label id="statusWrap"><span>Status</span><select id="status"><option value="">Semua</option><option>completed</option><option>success</option><option>pending</option><option>failed</option><option>unknown</option><option>debit_confirmed</option></select></label></section>
    <section id="content" aria-live="polite"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></section>
    <footer id="pagination"><button id="prev">← Sebelumnya</button><span id="page"></span><button id="next">Berikutnya →</button></footer>
  </main>
  <section id="login" class="login hidden" aria-labelledby="loginTitle"><div class="login-art" aria-hidden="true"><div class="spark s1"></div><div class="spark s2"></div><b>N</b><h2>Owner Console</h2><p>Operasional aman dalam satu tampilan.</p></div><div class="login-card"><div class="login-brand"><i>N</i><span>Nicola Owner</span></div><p class="eyebrow">AKSES TERBATAS</p><h1 id="loginTitle">Selamat datang</h1><p>Masuk dengan akun owner yang terdaftar. Secret tidak disimpan di browser.</p><form id="loginForm"><label><span>Nomor owner</span><input name="owner" inputmode="numeric" autocomplete="username" required autofocus></label><label><span>Secret dashboard</span><input name="secret" type="password" autocomplete="current-password" required></label><button type="submit"><span>Masuk aman</span><b aria-hidden="true">→</b></button><p id="loginError" role="alert" aria-live="assertive"></p></form></div></section>
<script>
// @ts-nocheck
import { handleLogin } from '../login.js';
const api=document.body.dataset.api,$=id=>document.getElementById(id);let view='overview',currentPage=1,pages=1,csrf='';
const labels={overview:['Ringkasan','Kondisi bisnis dan layanan terkini.'],products:['Produk & stok','Katalog, harga, dan jumlah stok tanpa membuka credential.'],users:['Pengguna & saldo','Saldo dan peran pengguna; mutasi dinonaktifkan demi integritas.'],transactions:['Transaksi','Cari dan saring transaksi aktual.'],finance:['Keuangan','Agregat transaksi dari data produksi.'],'deposits-payments':['Deposit & pembayaran','Status flow pembayaran tanpa memicu provider.'],zoom:['Zoom','Kapasitas pool tanpa membuka credential host.'],'services-otp':['OTP & layanan','Jumlah order berdasarkan status; OTP tidak ditampilkan.'],configuration:['Konfigurasi bot','Status integrasi dan promo tanpa nilai secret.'],health:['Health','Kesehatan dependency dan anomali terdeteksi.'],capabilities:['Cakupan fitur','Dukungan aman saat ini dan alasan pembatasan.']};
const money=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Number(n||0));const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function request(path,options={}){const r=await fetch(`${api}${path}`,{credentials:'same-origin',...options,headers:{'Content-Type':'application/json',...(csrf?{'X-CSRF-Token':csrf}:{}),...options.headers}});if(!(r.headers.get('content-type')||'').includes('application/json'))throw new Error('API belum tersambung: respons bukan JSON.');let body;try{body=await r.json()}catch{throw new Error('Respons API tidak valid.')}if(!r.ok||body.success!==true)throw Object.assign(new Error(typeof body.error==='string'?body.error:body.error?.message||'Permintaan API gagal'),{status:r.status});if(body.data===undefined||body.data===null)throw new Error('Respons API tidak memuat data.');return body.data}
function empty(msg='Belum ada data untuk ditampilkan.'){return `<div class="empty"><i>◇</i><b>Tidak ada data</b><p>${esc(msg)}</p></div>`}function status(v){const s=String(v??'—'),type=/fail|error|nonaktif|tidak/i.test(s)?'bad':/success|active|sehat|aktif|ya/i.test(s)?'ok':/pending|process/i.test(s)?'wait':'';return `<span class="chip ${type}"><i>${type==='ok'?'✓':type==='bad'?'×':'•'}</i>${esc(s)}</span>`}function cards(items){return `<div class="cards">${items.map(([k,v,s='',tone='amber'])=>`<article class="metric ${tone}"><div class="metric-icon">${tone==='purple'?'◇':tone==='cyan'?'◉':'↗'}</div><p>${esc(k)}</p><strong>${esc(v)}</strong>${s?`<small>${esc(s)}</small>`:''}</article>`).join('')}</div>`}function table(head,rows,statusAt=-1){if(!rows.length)return empty();return `<div class="table-card"><div class="table"><table><thead><tr>${head.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map((v,i)=>`<td>${i===statusAt?status(v):esc(v)}</td>`).join('')}</tr>`).join('')}</tbody></table></div></div>`}
function bars(data){const values=[['Pengguna',data.users,'amber'],['Produk',data.products,'purple'],['Stok',data.stock,'cyan'],['Transaksi',data.transactions,'green']],max=Math.max(1,...values.map(x=>Number(x[1])||0));return `<section class="chart-card"><div><p class="eyebrow">DATA AKTUAL</p><h2>Komposisi operasional</h2></div><div class="bars">${values.map(([k,v,c])=>`<div><span>${esc(k)}</span><i><b class="${c}" style="width:${Math.max(3,(Number(v)||0)/max*100)}%"></b></i><strong>${esc(v)}</strong></div>`).join('')}</div></section>`}
function render(data){pages=data?.pagination?.pages||1;$('page').textContent=pages>1?`Halaman ${currentPage} dari ${pages}`:'';$('prev').disabled=currentPage<=1;$('next').disabled=currentPage>=pages;$('pagination').classList.toggle('hidden',pages<=1);
 if(view==='overview')return `<div class="welcome"><div><p class="eyebrow">PANTAU HARI INI</p><h2>Semua sistem dalam jangkauan.</h2></div><span>Diperbarui ${new Date(data.generatedAt).toLocaleString('id-ID')}</span></div>${cards([['Pengguna',data.users,'Akun terdaftar','amber'],['Produk',data.products,'Katalog aktif','purple'],['Stok tersedia',data.stock,'Unit tercatat','cyan'],['Transaksi',data.transactions,'Seluruh transaksi','green'],['Nilai transaksi tercatat',money(data.revenue),'Semua transaksi sepanjang waktu','amber']])}${bars(data)}`;
 if(view==='products')return table(['Produk','Nama','Harga','Stok','Status'],(data.items||[]).map(x=>[x.id,x.name,money(x.prices?.bronze??x.price),x.stock,x.status]),4);
 if(view==='users')return table(['Pengguna','Nama','Saldo','Peran','Aktif'],(data.items||[]).map(x=>[x.displayId,x.username||'—',money(x.saldo),x.role,x.active?'Ya':'Tidak']),4);
 if(view==='transactions')return table(['Referensi','Pengguna','Produk','Pembayaran','Nominal','Status'],(data.items||[]).map(x=>[x.refId,x.userId?`••••${x.userId.replace(/\D/g,'').slice(-4)}`:'—',x.product||'—',x.payment||'—',money(x.amount),x.status]),5);
 if(view==='finance')return cards([['Nilai transaksi tercatat',money(data.gross),'Semua transaksi sepanjang waktu','amber'],...(data.confirmedAmount==null?[]:[['Transaksi berstatus berhasil',money(data.confirmedAmount),'Status completed / success, bukan bukti settlement','green']]),...(data.legacyFinanceTotal==null?[]:[['Total finance lama',money(data.legacyFinanceTotal),'totalBayar saja; tanpa fallback harga × jumlah','cyan']]),['Jumlah transaksi',data.count,'','purple'],...Object.entries(data.byStatus||{}).map(([k,v])=>[`Status ${k}`,v,'','cyan'])]);
 if(view==='deposits-payments')return table(['Order','Status','Nominal','Dibuat'],(data.items||[]).map(x=>[x.id,x.status,money(x.amount),x.createdAt?new Date(x.createdAt).toLocaleString('id-ID'):'—']),1);
 if(view==='zoom')return table(['Tier','Host','Aktif','Nonaktif','Kapasitas'],(data.tiers||[]).map(x=>[x.tier,x.hosts,x.enabled,x.disabled,x.capacity??'—']));
 if(view==='services-otp')return cards([['Total order OTP',data.total,'','amber'],...Object.entries(data.byState||{}).map(([k,v])=>[k,v,'','purple'])]);
 if(view==='configuration')return cards([['Database',data.database,'','cyan'],['Promo',data.promo.enabled?'Aktif':'Nonaktif',`${data.promo.groups} grup`,'amber'],...Object.entries(data.integrations).map(([k,v])=>[k,v?'Terpasang':'Tidak terpasang','','purple'])]);
 if(view==='health'){const h=data.health||{};return cards([['Uptime API',`${h.uptimeSeconds||0} detik`,'','cyan'],['Memori API',`${h.memory?.rssMiB||0} MiB`,'','purple'],...Object.entries(h.dependencies||{}).map(([k,v])=>[k,v.disabled?'Tidak diperiksa':v.ok?'Sehat':'Perlu diperiksa','','amber']),...Object.entries(data.anomalies||{}).filter(([,v])=>typeof v==='number').map(([k,v])=>[k,v,'','amber'])])}if(view==='capabilities')return table(['Area','Baca','Mutasi','Keterangan'],data.map(x=>[x.area,x.read?'Ya':'Tidak',x.write?'Ya':'Belum',x.reason]));return empty()}
function setAuthenticated(value){document.body.classList.toggle('authenticated',value);document.body.classList.remove('auth-pending');$('login').classList.toggle('hidden',value);$('app').setAttribute('aria-hidden',String(!value));$('sidebar').setAttribute('aria-hidden',String(!value))}
async function load(){setAuthenticated(true);$('content').innerHTML='<div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>';const query=new URLSearchParams({page:String(currentPage),limit:'20'});if($('search').value)query.set('search',$('search').value);if(view==='transactions'&&$('status').value)query.set('status',$('status').value);try{const data=await request(`/${view}?${query}`);$('connection').textContent='● Tersambung';$('content').innerHTML=render(data);const searchable=['products','users','transactions'].includes(view);$('toolbar').classList.toggle('hidden',!searchable);$('statusWrap').classList.toggle('hidden',view!=='transactions')}catch(e){if(e.status===401){csrf='';setAuthenticated(false);$('toolbar').classList.add('hidden');$('content').innerHTML='';$('connection').textContent='Belum masuk'}else{$('content').innerHTML=`<div class="error"><i>!</i><b>Data gagal dimuat</b><p>${esc(e.message)}</p><button id="retry">Coba lagi</button></div>`;$('retry').onclick=load;$('connection').textContent='Terputus'}}}
function closeMenu(){$('sidebar').classList.remove('open');$('scrim').classList.remove('open');$('menu').setAttribute('aria-expanded','false')}async function select(next){view=next;currentPage=1;[$('title').textContent,$('subtitle').textContent]=labels[view];$('crumb').textContent=labels[view][0].toUpperCase();document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===view));closeMenu();await load()}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>select(b.dataset.view));$('menu').onclick=()=>{const open=$('sidebar').classList.toggle('open');$('scrim').classList.toggle('open',open);$('menu').setAttribute('aria-expanded',String(open))};$('scrim').onclick=closeMenu;$('refresh').onclick=load;$('prev').onclick=()=>{currentPage--;load()};$('next').onclick=()=>{currentPage++;load()};let timer;$('search').oninput=()=>{clearTimeout(timer);timer=setTimeout(()=>{currentPage=1;load()},250)};$('status').onchange=()=>{currentPage=1;load()};$('loginForm').onsubmit=e=>handleLogin(e,{request,setCsrf:value=>{csrf=value},load,setError:value=>{$('loginError').textContent=value}});$('logout').onclick=async()=>{try{await request('/auth/logout',{method:'POST'});csrf='';await load()}catch(e){if(e.status===401){csrf='';setAuthenticated(false)}else $('connection').textContent=e.message}};async function boot(){try{const session=await request('/auth/me');csrf=session.csrfToken||'';await select('overview')}catch(e){if(e.status===401){setAuthenticated(false);$('connection').textContent='Belum masuk'}else{setAuthenticated(false);$('loginError').textContent=e.message;$('connection').textContent='Terputus'}}}boot();
</script>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Righteous&family=Space+Mono:wght@400;700&display=swap');
:root{font-family:Inter,ui-sans-serif,system-ui;color:#25262a;background:#f5f8fa;--amber:#eab308;--purple:#9333ea;--cyan:#06b6d4;--line:#e4e4e7;--muted:#71717a}*{box-sizing:border-box}body{margin:0;min-height:100vh;padding:72px 0 0 232px}button,input,select{font:inherit}button{cursor:pointer}.topbar{height:72px;background:#fff;border-bottom:1px solid var(--line);position:fixed;inset:0 0 auto;z-index:20;display:flex;align-items:center;padding:0 24px;box-shadow:0 1px 3px #18181b0d}.brand{width:208px;display:flex;align-items:center;gap:8px;text-decoration:none;color:#27272a}.brand i,.login-brand i{width:38px;height:38px;border-radius:12px;background:var(--amber);display:grid;place-items:center;color:#18181b;font:24px Righteous;box-shadow:0 4px 0 #ca8a04}.brand strong{font:22px Righteous;color:#4c1d75}.brand span{font-size:12px;font-weight:800;color:var(--muted)}.top-actions{margin-left:auto;display:flex;align-items:center;gap:10px}.top-actions>span{font:12px 'Space Mono';color:#15803d}.top-actions button,#pagination button,.error button{border:1px solid var(--line);background:#fff;border-radius:10px;padding:9px 13px;font-weight:700}.icon-button{width:42px;height:42px;padding:0!important;display:grid;place-items:center}.topbar>#menu{display:none;border:0;background:transparent}.topbar>#menu span{display:block;width:20px;height:2px;background:#27272a;margin:2px}aside{position:fixed;z-index:15;left:0;top:72px;bottom:0;width:232px;background:#fff;border-right:1px solid var(--line);padding:24px 14px;overflow:auto}.nav-label,.eyebrow{font-size:11px;letter-spacing:.15em;font-weight:800;color:#a1a1aa}.nav-label{padding:0 12px 10px}nav{display:grid;gap:4px}nav button{border:0;background:transparent;min-height:43px;border-radius:9px;display:flex;align-items:center;gap:12px;text-align:left;color:#52525b;padding:8px 11px;font-size:13px;font-weight:600}nav button i{font:18px 'Space Mono';width:22px;text-align:center}nav button:hover{background:#fafafa;color:#18181b}nav button.active{background:#fef9c3;color:#713f12;box-shadow:inset 3px 0 var(--amber)}.privacy{font-size:11px;color:#a1a1aa;padding:18px 11px;margin:12px 0 0;border-top:1px solid #f4f4f5}main{padding:34px clamp(20px,4vw,56px);max-width:1600px;margin:auto}.page-head{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:25px}.page-head h1,.login h1{font:40px/1.15 Righteous;margin:6px 0 7px;color:#27272a}.page-head p{margin:0;color:var(--muted)}.welcome{padding:22px 25px;margin-bottom:16px;border-radius:16px;color:#fff;background:linear-gradient(105deg,#3b0764,#6b21a8 55%,#0891b2);display:flex;align-items:center;justify-content:space-between;box-shadow:0 8px 18px #581c8726}.welcome h2{font:24px Righteous;margin:5px 0}.welcome .eyebrow{color:#fde68a}.welcome>span{font:12px 'Space Mono';color:#cffafe}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:15px}.metric{position:relative;background:#fff;border:2px solid var(--line);border-radius:16px;padding:20px;min-height:152px;box-shadow:0 4px 8px #0000000d;overflow:hidden}.metric:after{content:'';position:absolute;inset:auto 0 0;height:4px;background:var(--accent)}.metric.amber{--accent:var(--amber)}.metric.purple{--accent:var(--purple)}.metric.cyan{--accent:var(--cyan)}.metric.green{--accent:#22c55e}.metric-icon{float:right;width:38px;height:38px;border-radius:12px;background:color-mix(in srgb,var(--accent) 14%,white);color:var(--accent);display:grid;place-items:center;font-weight:900}.metric p{margin:5px 0;color:var(--muted);font-size:12px;font-weight:700}.metric strong{display:block;font:700 23px 'Space Mono';margin:20px 0 8px}.metric small{color:#a1a1aa;font-size:11px}.chart-card,.table-card,.empty,.error{background:#fff;border:2px solid var(--line);border-radius:16px;box-shadow:0 4px 8px #0000000a}.chart-card{margin-top:16px;padding:24px;display:grid;grid-template-columns:230px 1fr;gap:30px}.chart-card h2{font:20px Righteous;margin:7px 0}.bars{display:grid;gap:14px}.bars>div{display:grid;grid-template-columns:90px 1fr 70px;align-items:center;gap:12px;font-size:12px}.bars i{height:10px;background:#f4f4f5;border-radius:99px;overflow:hidden}.bars b{height:100%;display:block;border-radius:99px;background:var(--amber)}.bars b.purple{background:var(--purple)}.bars b.cyan{background:var(--cyan)}.bars b.green{background:#22c55e}.bars strong{text-align:right;font:12px 'Space Mono'}.toolbar{display:flex;gap:14px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:16px}.toolbar label,form label{display:grid;gap:6px;font-size:12px;font-weight:700;color:#52525b}.search{flex:1}input,select{border:1px solid #d4d4d8;background:#fff;border-radius:12px;padding:11px 13px;min-height:44px}input:focus,select:focus,button:focus-visible{outline:0;box-shadow:0 0 0 3px #eab30859;border-color:var(--amber)}.table-card{overflow:hidden}.table{overflow:auto}table{border-collapse:collapse;width:100%;min-width:680px}th,td{padding:14px 16px;text-align:left;border-bottom:1px solid #f4f4f5;font-size:13px}th{font-size:11px;text-transform:uppercase;letter-spacing:.08em;background:#fafafa;color:#71717a}tbody tr:hover{background:#fffbeb}.chip{display:inline-flex;align-items:center;gap:6px;border-radius:99px;background:#f4f4f5;padding:5px 9px;font-size:11px;font-weight:800}.chip.ok{color:#15803d;background:#dcfce7}.chip.bad{color:#b91c1c;background:#fee2e2}.chip.wait{color:#0e7490;background:#cffafe}.empty,.error{padding:60px;text-align:center;color:var(--muted)}.empty i,.error i{width:44px;height:44px;display:grid;place-items:center;margin:0 auto 12px;border-radius:50%;background:#fef9c3;color:#a16207;font:22px 'Space Mono'}.empty b,.error b{display:block;color:#27272a}.skeleton{height:152px;border-radius:16px;margin-bottom:15px;background:linear-gradient(90deg,#eef1f3,#fff,#eef1f3);background-size:200%;animation:p 1.2s infinite}@keyframes p{to{background-position:-200%}}#pagination{display:flex;justify-content:flex-end;align-items:center;gap:14px;margin-top:18px;font:12px 'Space Mono'}.hidden{display:none!important}.login{position:fixed;z-index:50;inset:0;background:#f5f8fa;display:grid;grid-template-columns:minmax(330px,1fr) minmax(420px,600px)}.login-art{position:relative;display:grid;place-content:center;text-align:center;color:white;overflow:hidden;background:linear-gradient(145deg,#3b0764,#7e22ce 54%,#0891b2)}.login-art:after{content:'';position:absolute;width:500px;height:500px;border:80px solid #ffffff0b;border-radius:50%;left:-180px;bottom:-220px}.login-art>b{font:110px Righteous;color:#18181b;background:var(--amber);width:180px;height:180px;display:grid;place-items:center;margin:auto;border-radius:48px;transform:rotate(-4deg);box-shadow:0 16px 0 #ca8a04}.login-art h2{font:36px Righteous;margin:34px 0 8px}.login-art p{color:#e9d5ff}.spark{position:absolute;border-radius:50%;background:#facc15}.s1{width:18px;height:18px;top:18%;left:18%}.s2{width:10px;height:10px;right:20%;bottom:24%;background:#67e8f9}.login-card{align-self:center;padding:60px clamp(32px,7vw,90px)}.login-brand{display:flex;align-items:center;gap:12px;margin-bottom:55px;font:20px Righteous;color:#4c1d75}.login-brand i{display:grid;width:38px;height:38px}.login-card>p:not(.eyebrow){color:var(--muted);line-height:1.6}.login-card form{display:grid;gap:18px;margin-top:30px}.login-card form button{border:0;border-radius:16px;min-height:52px;padding:0 20px;background:var(--amber);color:#18181b;display:flex;justify-content:space-between;align-items:center;font-weight:800;box-shadow:0 5px 0 #ca8a04}.login-card form button:disabled{opacity:.55;cursor:wait}.login-card form button b{font-size:22px}.login-card #loginError{color:#b91c1c;min-height:21px;margin:0;font-size:13px}.auth-pending #app,.auth-pending #sidebar,.auth-pending .topbar{visibility:hidden}.authenticated .login{display:none}.scrim{display:none}
@media(max-width:900px){body{padding-left:0}.topbar>#menu{display:grid}.brand{width:auto}.brand span{display:none}aside{transform:translateX(-100%);transition:transform .2s;top:72px;box-shadow:12px 0 30px #18181b22}aside.open{transform:none}.scrim.open{display:block;position:fixed;z-index:14;inset:72px 0 0;background:#18181b66}.chart-card{grid-template-columns:1fr}.login{grid-template-columns:1fr}.login-art{display:none}.login-card{max-width:560px;width:100%;margin:auto}.welcome{align-items:flex-start;gap:20px;flex-direction:column}}
