{
  "name": "bot-wa-owner",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "main": "worker/index.js",
  "vars": {
    "OWNER_API_UPSTREAM": "https://pay.ghzm.us"
  }
}
